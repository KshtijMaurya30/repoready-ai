GOOGLE_API_KEY=
# Set this to the exact Gemma model identifier supported by your Google AI account.
GEMMA_MODEL=
# Set true only if the configured Gemma model accepts image input.
GEMMA_MODEL_SUPPORTS_VISION=false

# Optional GitHub fine-grained token. It is only used for public API reads.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_IMAGE_BYTES=8388608
RATE_LIMIT_PER_MINUTE=20
REQUEST_TIMEOUT_SECONDS=15

